# Secrets — never commit real WordPress credentials
.env
pipeline_config.json
offline_bundle.json
*bundle*.json
!offline_bundle.example.json

# Firebase — never commit these either
firebase_config.json
firebase_session.json

# Leftover from earlier Google OAuth experiments — no longer used by the
# app (sign-in is email/password now), but keep ignored as a safety net
# in case old copies still exist on disk.
credentials.json
token.json

# Generated at runtime — one folder per processed URL, plus its local DB/images
pipeline_output/

# Personal run data — your own URL list
Links.csv

# Python
__pycache__/
*.pyc

# PyInstaller build output
build_output/
Test/

# Local Claude Code tool settings
.claude/

# Misc
Automation.rar
*.txt
